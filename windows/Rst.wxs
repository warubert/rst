<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="RST"
    Manufacturer="William Antunes Rubert"
    Version="$(var.ProductVersion)"
    UpgradeCode="{F4C30D48-8D24-4E78-B34A-A7A139A5310B}"
    Scope="perMachine"
    InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer version of RST is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="Main" Title="RST" Level="1">
      <ComponentRef Id="RstExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Package>

  <?if $(var.Architecture) = x64 ?>
  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RST" />
    </StandardDirectory>
  </Fragment>
  <?else ?>
  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="RST" />
    </StandardDirectory>
  </Fragment>
  <?endif ?>

  <Fragment>
    <Component Id="RstExecutable" Directory="INSTALLFOLDER" Guid="*">
      <File Id="RstExe" Source="$(var.RstExe)" KeyPath="yes" />
      <Environment
        Id="RstPath"
        Name="PATH"
        Value="[INSTALLFOLDER]"
        Part="last"
        Action="set"
        System="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="RST" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
        Id="StartMenuShortcut"
        Name="RST"
        Target="[#RstExe]"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
      <RegistryValue
        Root="HKLM"
        Key="Software\RST"
        Name="StartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut
        Id="DesktopShortcut"
        Name="RST"
        Target="[#RstExe]"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue
        Root="HKLM"
        Key="Software\RST"
        Name="DesktopShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
